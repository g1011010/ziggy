// Cloudflare Workers config: one Worker serves the app and the Yahoo relay.
// The app's files are bundled into the script (worker/site.js) by the build
// step, so `wrangler deploy` is a single upload with no separate assets.
{
  "name": "ziggy",
  "main": "worker/proxy.js",
  "compatibility_date": "2025-01-01",
  "build": {
    "command": "node scripts/build-worker.mjs",
    "watch_dir": ["index.html", "css", "js", "icons", "vendor", "sw.js", "manifest.webmanifest"]
  }
}
